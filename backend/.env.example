# ── RegulaAI Backend Environment Variables ──
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ──
PROJECT_NAME=RegulaAI
API_V1_STR=/api
ENVIRONMENT=development

# ── Security ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ISSUER=regulaai-api
JWT_AUDIENCE=regulaai-web
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ── Database ──
SQLALCHEMY_DATABASE_URI=postgresql://postgres:local_dev_only@localhost:5432/regula_ai

# ── CORS ──
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── OpenAI (for agent workflows) ──
# OPENAI_API_KEY=sk-...
MODEL_EXECUTION_ENABLED=false
AI_REQUESTS_PER_TENANT_PER_DAY=100
AI_TOKENS_PER_TENANT_PER_DAY=200000
# OPS_METRICS_TOKEN: managed operator credential, at least 32 characters.
# HEALTHCHECK_HOST: the API hostname included in production ALLOWED_HOSTS.

# ── Redis (for caching/queue) ──
REDIS_URL=redis://localhost:6379/0

# â”€â”€ Rate limiting â”€â”€
ENABLE_RATE_LIMITING=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
AGENT_RATE_LIMIT_PER_MINUTE=20

# â”€â”€ Private uploads â”€â”€
STORAGE_BACKEND=local
UPLOAD_STORAGE_DIR=var/private-uploads
MAX_UPLOAD_BYTES=26214400
# Staging/production require STORAGE_BACKEND=s3 and a private bucket.
# Credentials should come from the platform's workload role/SDK credential chain.
# S3_BUCKET=regulaai-private-documents
# S3_ENDPOINT_URL=
AWS_REGION=ap-south-1
